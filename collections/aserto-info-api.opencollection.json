{
  "opencollection": "1.0.0",
  "info": {
    "name": "aserto//v2/.proto Authorizer Info API",
    "version": "version not set"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "authorization",
      "value": "{{authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Info",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v2/info"
          },
          "docs": "Return version information."
        }
      ]
    }
  ],
  "bundled": true
}