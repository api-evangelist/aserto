              },
              {
                "name": "policy_instance.name",
                "value": "",
                "type": "query",
                "description": "policy name"
              },
              {
                "name": "policy_instance.instance_label",
                "value": "",
                "type": "query",
                "description": "label identifying the instance of the policy"
              }
