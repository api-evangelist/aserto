{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "v3Metadata",
  "description": "v3Metadata schema from Aserto directory API",
  "properties": {
    "etag": {
      "title": "object instance etag",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "readOnly": true,
      "title": "last updated timestamp (UTC)",
      "type": "string"
    }
  },
  "type": "object"
}